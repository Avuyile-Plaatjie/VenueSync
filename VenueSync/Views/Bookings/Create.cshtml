<div asp-validation-summary="All" class="text-danger"></div>
@model VenueSync.Models.Booking
@{
    ViewData["Title"] = "Create Booking";
}

<h1>Create Booking</h1>
<p>Select an event, venue, and booking date.</p>

<form asp-action="Create" method="post">
    <div>
        <label asp-for="EventId"></label>
        <select asp-for="EventId" class="form-control" asp-items="ViewBag.EventId"></select>
        <span asp-validation-for="EventId" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="VenueId"></label>
        <select asp-for="VenueId" class="form-control" asp-items="ViewBag.VenueId"></select>
        <span asp-validation-for="VenueId" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="BookingDate"></label>
        <input asp-for="BookingDate" type="date" class="form-control" />
        <span asp-validation-for="BookingDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn-primary">Save Booking</button>
    <a href="/Bookings" class="btn-secondary">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .btn-primary {
        background-color: #007bff;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        margin-top: 1rem;
    }

        .btn-primary:hover {
            background-color: #0056b3;
        }

    .btn-secondary {
        background-color: black;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        margin-left: 0.5rem;
    }

        .btn-secondary:hover {
            background-color: #333;
        }

    .form-control {
        width: 100%;
        padding: 0.5rem;
        margin-bottom: 0.8rem;
        border-radius: 4px;
        border: 1px solid #ccc;
    }
</style>