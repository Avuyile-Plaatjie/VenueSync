<div asp-validation-summary="All" class="text-danger"></div>
@model VenueSync.Models.Booking

<h2>Edit Booking</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="BookingId" />

    <label>Venue</label>
    <select asp-for="VenueId" asp-items="ViewBag.VenueId"></select>

    <label>Event</label>
    <select asp-for="EventId" asp-items="ViewBag.EventId"></select>

    <label>Date</label>
    <input asp-for="BookingDate" type="date" />

    <button type="submit" class="button">Update</button>
</form>