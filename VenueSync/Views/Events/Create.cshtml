@model VenueSync.Models.Event
@{
    ViewData["Title"] = "Add Event";
}

<h2>Add Event</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="EventName"></label>
        <input asp-for="EventName" class="form-control" />
        <span asp-validation-for="EventName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="EventDate"></label>
        <input asp-for="EventDate" class="form-control" type="date" />
        <span asp-validation-for="EventDate" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="VenueId">Select Venue</label>
        <select asp-for="VenueId" asp-items="ViewBag.VenueId" class="form-control">
            <option value="">-- Select Venue --</option>
        </select>
        <span asp-validation-for="VenueId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <button type="submit" class="btn-submit">Create Event</button>
    <a href="/Events" class="btn-cancel">Cancel</a>
</form>

<style>
    form {
        max-width: 600px;
        margin: 0 auto;
        background-color: white;
        padding: 2rem;
        border-radius: 8px;
        box-shadow: 0 3px 6px rgba(0,0,0,0.1);
    }

    .form-group {
        margin-bottom: 1rem;
    }

    .form-control {
        width: 100%;
        padding: 0.5rem;
        border-radius: 5px;
        border: 1px solid #ccc;
    }

    .btn-submit {
        background-color: #007bff;
        color: white;
        padding: 0.5rem 1.2rem;
        border-radius: 5px;
        border: none;
        margin-right: 0.5rem;
    }

        .btn-submit:hover {
            background-color: #0056b3;
            transform: translateY(-1px);
        }

    .btn-cancel {
        background-color: black;
        color: white;
        padding: 0.5rem 1.2rem;
        border-radius: 5px;
        text-decoration: none;
    }

        .btn-cancel:hover {
            background-color: #333;
            transform: translateY(-1px);
        }
</style>