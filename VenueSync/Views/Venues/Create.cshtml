@model VenueSync.Models.Venue
@{
    ViewData["Title"] = "Add Venue";
}

<h1>Add Venue</h1>
<p>Fill in the details to add a new venue.</p>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div>
        <label asp-for="VenueName"></label>
        <input asp-for="VenueName" class="form-control" />
        <span asp-validation-for="VenueName" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Location"></label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Capacity"></label>
        <input asp-for="Capacity" type="number" class="form-control" />
        <span asp-validation-for="Capacity" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Description"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div>
        <label>Venue Image</label>
        <input type="file" name="ImageFile" class="form-control" />
    </div>

    <button type="submit" class="btn-primary">Save Venue</button>
    <a href="/Venues" class="btn-secondary">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .btn-primary {
        background-color: #007bff;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        margin-top: 1rem;
    }

        .btn-primary:hover {
            background-color: #0056b3;
        }

    .btn-secondary {
        background-color: black;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 4px;
        margin-left: 0.5rem;
    }

        .btn-secondary:hover {
            background-color: #333;
        }

    .form-control {
        width: 100%;
        padding: 0.5rem;
        margin-bottom: 0.8rem;
        border-radius: 4px;
        border: 1px solid #ccc;
    }
</style>